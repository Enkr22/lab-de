table fct_payroll_movement
	lineageTag: 8d081632-66df-4bca-8415-934a34771c1b

	measure 'Monto bruto' = SUM ( fct_payroll_movement[amount] )
		lineageTag: 0a103a4e-004b-49ca-a8be-8763cc6f75e1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Monto neto' =
			
			IF (
			    HASONEVALUE ( dim_country[country_code] ),
			    SUM ( fct_payroll_movement[signed_amount] )
			)
		lineageTag: 662e2d60-3992-4050-aaa8-36b33c6059ab

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Percepciones =
			
			IF (
			    HASONEVALUE ( dim_country[country_code] ),
			    CALCULATE ( SUM ( fct_payroll_movement[amount] ), dim_concept[concept_type] = "EARNING" )
			)
		formatString: #,0.00
		lineageTag: efbc74f3-b07f-47b1-b792-3ceffec0d366

	measure Deducciones =
			
			IF (
			    HASONEVALUE ( dim_country[country_code] ),
			    CALCULATE ( SUM ( fct_payroll_movement[amount] ), dim_concept[concept_type] = "DEDUCTION" )
			)
		formatString: #,0.00
		lineageTag: 57f8a2e1-a6f3-4972-8c11-2be7c899c218

	measure 'Empleados pagados' = DISTINCTCOUNT ( fct_payroll_movement[employment_id] )
		formatString: 0
		lineageTag: d7888e89-09a9-4a8d-befe-441b916209cf

