table fct_settlement
	lineageTag: ad4600dc-c7c2-432b-ab2d-af0795e21dbc

	measure Finiquitos = COUNTROWS ( fct_settlement )
		formatString: 0
		lineageTag: 8c2f5778-bce1-401a-97b2-2dec3aca8478

	measure 'Indemnizaciones pagadas' =
			
			IF (
			    HASONEVALUE ( dim_country[country_code] ),
			    CALCULATE ( SUM ( fct_settlement[indemnity_amount] ), fct_settlement[status] = "PAID" )
			)
